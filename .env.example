# Container settings
CONTAINER_NAME=my-website-php
VOLUME_PREFIX=my-website
CONTAINER_IP=172.50.0.10

# User settings (required)
PUID=1001
PGID=1001
USERNAME=user

# WordPress
WP_DOMAIN=example.com
WP_PATH=/var/www/example.com/public
LOG_PATH=/var/www/example.com/logs

# PHP
TIMEZONE=Europe/Amsterdam
PHP_MEMORY_LIMIT=256M
PHP_UPLOAD_MAX_FILESIZE=64M
PHP_POST_MAX_SIZE=64M
PHP_MAX_EXECUTION_TIME=300
PHP_MAX_INPUT_VARS=4000

# PHP-FPM / status
REQUEST_TERMINATE_TIMEOUT=60s
ENABLE_STATUS_ENDPOINTS=true

# APCu
APC_SHM_SIZE=32M

# OPcache
OPCACHE_MEMORY_CONSUMPTION=348
OPCACHE_INTERNED_STRINGS_BUFFER=32
OPCACHE_MAX_ACCELERATED_FILES=10000
OPCACHE_REVALIDATE_FREQ=30
OPCACHE_VALIDATE_TIMESTAMPS=1

# Sessions
SESSION_SAVE_PATH=/var/lib/php/sessions

# PHP-FPM pool
PM_TYPE=dynamic
PM_MAX_CHILDREN=20
PM_START_SERVERS=5
PM_MIN_SPARE_SERVERS=3
PM_MAX_SPARE_SERVERS=10
PM_MAX_REQUESTS=500

# SMTP (host IP on the bridge network)
# SMTP_FROM is only a fallback: mail goes through the msmtp-sendmail wrapper,
# which runs msmtp with --read-envelope-from so the SMTP envelope sender is
# derived from each message's From header (keeps SPF/DKIM/DMARC aligned for
# sites that send from multiple domains). The wrapper also strips any -f/--from
# PHPMailer injects, so plugins that set PHPMailer->Sender (e.g. Booking
# Calendar) do not break mail delivery.
SMTP_HOST=172.50.0.1
SMTP_PORT=25
SMTP_FROM=localhost